@implements IDisposable
@inject NavigationManager Nav

<a href="/" class="brand">
    <div class="brand-mark" aria-hidden="true">
        <span class="brand-stripe stripe-1"></span>
        <span class="brand-stripe stripe-2"></span>
        <span class="brand-stripe stripe-3"></span>
    </div>
    <span class="brand-name">Salone Sales</span>
</a>

<div class="nav-search">
    <i class="bi bi-search"></i>
    <input type="search" placeholder="Find page…" @bind="filter" @bind:event="oninput" />
    @if (!string.IsNullOrEmpty(filter))
    {
        <button class="nav-search-clear" @onclick="@(() => filter = "")" aria-label="Clear">
            <i class="bi bi-x"></i>
        </button>
    }
</div>

<nav class="nav">
    @if (!string.IsNullOrWhiteSpace(filter))
    {
        var matches = AllSections
            .SelectMany(s => s.Items)
            .Where(i => i.Label.Contains(filter, StringComparison.OrdinalIgnoreCase))
            .ToList();
        if (!matches.Any())
        {
            <div class="nav-empty"><i class="bi bi-emoji-frown"></i> No results</div>
        }
        else
        {
            @foreach (var item in matches)
            {
                <a href="@item.Href" class="nav-item @(IsActive(item.Href) ? "active" : "")">
                    <i class="bi @item.Icon"></i>
                    <span>@item.Label</span>
                </a>
            }
        }
    }
    else
    {
        @foreach (var sec in AllSections)
        {
            if (sec.Label == null)
            {
                @foreach (var item in sec.Items)
                {
                    <a href="@item.Href" class="nav-item @(IsActive(item.Href) ? "active" : "")">
                        <i class="bi @item.Icon"></i>
                        <span>@item.Label</span>
                    </a>
                }
            }
            else
            {
                var isOpen = openSections.Contains(sec.Key);
                var hasActive = sec.Items.Any(i => IsActive(i.Href));
                <div class="nav-group @(isOpen ? "open" : "") @(hasActive ? "has-active" : "")">
                    <button class="nav-group-toggle" @onclick="() => Toggle(sec.Key)" type="button">
                        <i class="bi @sec.Icon"></i>
                        <span>@sec.Label</span>
                        @if (hasActive && !isOpen)
                        {
                            <span class="nav-active-dot" aria-hidden="true"></span>
                        }
                        <i class="bi bi-chevron-down chevron"></i>
                    </button>
                    <div class="nav-group-items">
                        @foreach (var item in sec.Items)
                        {
                            <a href="@item.Href" class="nav-item @(IsActive(item.Href) ? "active" : "")">
                                <i class="bi @item.Icon"></i>
                                <span>@item.Label</span>
                            </a>
                        }
                    </div>
                </div>
            }
        }
    }
</nav>

<div class="nav-footer">
    <div class="tenant-chip">
        <div class="tenant-dot"></div>
        <div class="tenant-meta">
            <strong>Demo Business</strong>
            <small>NLe · Sierra Leone</small>
        </div>
    </div>
</div>

@code {
    record NavItem(string Label, string Href, string Icon);
    record NavSection(string Key, string? Label, string? Icon, NavItem[] Items);

    static readonly NavSection[] AllSections = new[]
    {
        new NavSection("overview", null, null, new[]
        {
            new NavItem("Dashboard", "/", "bi-grid-1x2-fill"),
        }),
        new NavSection("sales", "Sales", "bi-receipt", new[]
        {
            new NavItem("All Sales",   "/sales",       "bi-list-ul"),
            new NavItem("New Sale",    "/sales/new",   "bi-plus-circle"),
            new NavItem("Quotations",  "/quotations",  "bi-file-earmark-text"),
            new NavItem("Layaways",    "/layaways",    "bi-piggy-bank"),
        }),
        new NavSection("analytics", "Analytics", "bi-graph-up-arrow", new[]
        {
            new NavItem("Reports",        "/reports", "bi-bar-chart"),
            new NavItem("Sales Targets",  "/targets", "bi-bullseye"),
        }),
        new NavSection("inventory", "Inventory", "bi-box-seam", new[]
        {
            new NavItem("Products",       "/products",   "bi-tag"),
            new NavItem("Stock Levels",   "/inventory",  "bi-clipboard-data"),
            new NavItem("Reorder Report", "/reorder",    "bi-exclamation-triangle"),
            new NavItem("Stock Take",     "/stock-take", "bi-list-check"),
            new NavItem("Stock Transfers","/transfers",  "bi-arrow-left-right"),
        }),
        new NavSection("procurement", "Procurement", "bi-truck", new[]
        {
            new NavItem("Suppliers",       "/suppliers",       "bi-building"),
            new NavItem("Purchase Orders", "/purchase-orders", "bi-cart3"),
        }),
        new NavSection("crm", "Customers (CRM)", "bi-people", new[]
        {
            new NavItem("All Customers", "/customers", "bi-person-lines-fill"),
        }),
        new NavSection("finance", "Finance & HR", "bi-bank", new[]
        {
            new NavItem("Expenses",     "/expenses",     "bi-cash-stack"),
            new NavItem("Employees",    "/employees",    "bi-person-badge"),
            new NavItem("Shifts",       "/shifts",       "bi-clock-history"),
            new NavItem("Commissions",  "/commissions",  "bi-cash-coin"),
        }),
        new NavSection("admin", "Administration", "bi-gear", new[]
        {
            new NavItem("Stores",     "/stores", "bi-shop"),
            new NavItem("Audit Log",  "/audit",  "bi-shield-check"),
        }),
    };

    string filter = "";
    string currentUri = "";
    HashSet<string> openSections = new();
    string? lastActiveKey;

    protected override void OnInitialized()
    {
        currentUri = Nav.Uri;
        Nav.LocationChanged += OnLocationChanged;
        AutoOpenActive();
    }

    void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        currentUri = e.Location;
        AutoOpenActive();
        StateHasChanged();
    }

    /// <summary>
    /// When the user navigates into a different section, auto-expand it.
    /// User can still close it manually afterwards.
    /// </summary>
    void AutoOpenActive()
    {
        var active = AllSections
            .Where(s => s.Label != null)
            .FirstOrDefault(s => s.Items.Any(i => IsActive(i.Href)));
        if (active != null && active.Key != lastActiveKey)
        {
            openSections.Add(active.Key);
            lastActiveKey = active.Key;
        }
    }

    void Toggle(string key)
    {
        if (!openSections.Add(key)) openSections.Remove(key);
    }

    bool IsActive(string href)
    {
        var path = new Uri(currentUri).AbsolutePath.TrimEnd('/');
        var target = href.TrimEnd('/');
        if (target == "") return path == "" || path == "/";
        return path == target || path.StartsWith(target + "/");
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}

@page "/audit"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ManagerOrAdmin")]
@inject AuditService Audit
@inject SettingsService Settings
@inject LayoutState Layout
@inject ToastService Toast

<PageTitle>Audit Log</PageTitle>

<div class="page-header">
    <div class="actions">
        <a class="btn" href="@CsvUrl" target="_blank"><i class="bi bi-download"></i> Export CSV</a>
        <button class="btn btn-danger" @onclick="() => purgeOpen = true"><i class="bi bi-trash"></i> Purge old</button>
    </div>
</div>

<div class="filter-bar">
    <label>Action
        <select @bind="action" @bind:after="ApplyFilter">
            <option value="">All</option>
            @foreach (var a in actions) { <option value="@a">@a</option> }
        </select>
    </label>
    <label>Entity
        <select @bind="entityType" @bind:after="ApplyFilter">
            <option value="">All</option>
            @foreach (var e in entityTypes) { <option value="@e">@e</option> }
        </select>
    </label>
    <label>User
        <select @bind="user" @bind:after="ApplyFilter">
            <option value="">All</option>
            @foreach (var u in users) { <option value="@u">@u</option> }
        </select>
    </label>
    <label>From<input type="date" @bind="from" @bind:after="ApplyFilter" /></label>
    <label>To<input type="date" @bind="to" @bind:after="ApplyFilter" /></label>
    <button class="btn btn-ghost btn-sm" @onclick="Clear"><i class="bi bi-x-lg"></i> Clear</button>
</div>

@if (paged == null) { <Skeleton Height="240" /> }
else
{
    <div class="kpi-grid" style="grid-template-columns: repeat(4, minmax(0, 1fr));">
        <KpiCard Title="Total events"  Value="@paged.TotalCount.ToString()"                                                Accent="indigo" Icon="bi-journal-text" />
        <KpiCard Title="Unique users"  Value="@distinctUsers.ToString()"                                                   Accent="blue"   Icon="bi-people" />
        <KpiCard Title="Actions"       Value="@distinctActions.ToString()"                                                 Accent="teal"   Icon="bi-lightning" />
        <KpiCard Title="Entities"      Value="@distinctEntities.ToString()"                                                Accent="purple" Icon="bi-collection" />
    </div>

    @if (!paged.Items.Any())
    {
        <EmptyState Icon="bi-shield-check" Title="No audit events match" Description="Adjust the filters or wait for system activity." />
    }
    else
    {
        <table class="table">
            <thead><tr><th>When</th><th>User</th><th>Action</th><th>Entity</th><th>ID</th><th>Details</th></tr></thead>
            <tbody>
                @foreach (var l in paged.Items)
                {
                    <tr style="cursor:pointer" @onclick="() => Open(l)">
                        <td class="tabular">@l.Timestamp.ToLocalTime().ToString("dd MMM HH:mm:ss")</td>
                        <td>
                            <div class="flex items-center gap-2">
                                <Avatar Name="@l.UserName" Size="sm" />
                                <span>@l.UserName</span>
                            </div>
                        </td>
                        <td><span class="status @ActionClass(l.Action)">@l.Action</span></td>
                        <td><code>@l.EntityType</code></td>
                        <td class="tabular text-muted">#@l.EntityId</td>
                        <td><span class="audit-details">@(l.Details ?? "—")</span></td>
                    </tr>
                }
            </tbody>
        </table>

        <Pager Page="page" PageSize="pageSize" TotalCount="paged.TotalCount"
               PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
    }
}

@if (detail != null)
{
    <div class="slideover-backdrop" @onclick="() => detail = null"></div>
    <aside class="slideover">
        <div class="slideover-head">
            <div>
                <h3>Audit event</h3>
                <p class="muted text-xs mb-0">@detail.Timestamp.ToLocalTime().ToString("dd MMM yyyy HH:mm:ss")</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="() => detail = null"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="slideover-body">
            <div class="audit-meta-grid">
                <div><label>User</label><div class="flex items-center gap-2"><Avatar Name="@detail.UserName" Size="sm" /><strong>@detail.UserName</strong></div></div>
                <div><label>Action</label><span class="status @ActionClass(detail.Action)">@detail.Action</span></div>
                <div><label>Entity</label><code>@detail.EntityType</code></div>
                <div><label>Entity ID</label><code>#@detail.EntityId</code></div>
            </div>

            <div class="form-section">
                <div class="form-section-title">Change details</div>
                @if (string.IsNullOrEmpty(detail.Details))
                {
                    <p class="muted">No additional details captured.</p>
                }
                else
                {
                    <div class="audit-diff">
                        @foreach (var part in (detail.Details ?? "").Split("; ", StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div class="audit-diff-row">@part</div>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="slideover-foot">
            <button class="btn" @onclick="() => detail = null">Close</button>
        </div>
    </aside>
}

<style>
    .audit-meta-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem 1.5rem; margin-bottom: 1.5rem; }
    .audit-meta-grid label { display:block; font-size: .7rem; text-transform: uppercase; letter-spacing: .04em; color: var(--text-muted); margin-bottom: .25rem; font-weight: 600; }
    .audit-diff { display: flex; flex-direction: column; gap: .35rem; font-family: ui-monospace, monospace; font-size: .82rem; }
    .audit-diff-row { padding: .55rem .75rem; background: var(--surface-2); border-left: 3px solid var(--brand); border-radius: var(--radius-sm); word-break: break-word; }
</style>

<ConfirmDialog @bind-Open="purgeOpen"
               Title="Purge old audit entries?"
               Message="@($"Removing audit entries older than {purgeDays} day(s). This is permanent.")"
               ConfirmText="Purge"
               Danger="true"
               OnConfirm="DoPurge" />

<style>
    .audit-details {
        font-family: ui-monospace, "SF Mono", monospace;
        font-size: .78rem;
        color: var(--text-2);
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
    .status-created { background: var(--success-bg); color: var(--success); border-color: var(--success-border); }
    .status-updated { background: var(--info-bg);    color: var(--info);    border-color: var(--info-border); }
    .status-deleted { background: var(--danger-bg);  color: var(--danger);  border-color: var(--danger-border); }
    .status-signin  { background: var(--brand-50);   color: var(--brand-700); border-color: var(--brand-100); }
    .status-cancelled, .status-refunded { background: #fff7ed; color: #c2410c; border-color: #fed7aa; }
</style>

@code {
    AuditService.PagedAudit? paged;
    List<string> actions = new();
    List<string> entityTypes = new();
    List<string> users = new();
    int distinctUsers, distinctActions, distinctEntities;

    string action = "";
    string entityType = "";
    string user = "";
    DateTime? from;
    DateTime? to;

    int page = 1;
    int pageSize = 25;

    bool purgeOpen;
    int purgeDays = 365;
    AuditLog? detail;

    void Open(AuditLog l) => detail = l;

    string CsvUrl
    {
        get
        {
            var qs = new List<string>();
            if (!string.IsNullOrEmpty(action))     qs.Add($"action={Uri.EscapeDataString(action)}");
            if (!string.IsNullOrEmpty(entityType)) qs.Add($"entityType={Uri.EscapeDataString(entityType)}");
            if (!string.IsNullOrEmpty(user))       qs.Add($"user={Uri.EscapeDataString(user)}");
            if (from.HasValue)                     qs.Add($"from={from:yyyy-MM-dd}");
            if (to.HasValue)                       qs.Add($"to={to:yyyy-MM-dd}");
            return "/export/audit.csv" + (qs.Any() ? "?" + string.Join("&", qs) : "");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Audit Log", "Every change in the system, captured automatically");
        purgeDays = await Settings.GetAsync(SettingKeys.AuditRetentionDays, 365);
        actions = await Audit.GetDistinctActionsAsync();
        entityTypes = await Audit.GetDistinctEntityTypesAsync();
        users = await Audit.GetDistinctUsersAsync();
        await Reload();
    }

    async Task Reload()
    {
        paged = await Audit.SearchPagedAsync(
            string.IsNullOrEmpty(action) ? null : action,
            string.IsNullOrEmpty(entityType) ? null : entityType,
            string.IsNullOrEmpty(user) ? null : user,
            from, to, page, pageSize);

        distinctActions  = actions.Count;
        distinctEntities = entityTypes.Count;
        distinctUsers    = users.Count;

        // Guard: if a filter reduced totals, ensure current page is still valid
        var maxPage = paged.TotalCount == 0 ? 1 : (int)Math.Ceiling((double)paged.TotalCount / pageSize);
        if (page > maxPage) { page = maxPage; paged = await Audit.SearchPagedAsync(
            string.IsNullOrEmpty(action) ? null : action,
            string.IsNullOrEmpty(entityType) ? null : entityType,
            string.IsNullOrEmpty(user) ? null : user,
            from, to, page, pageSize); }
    }

    /// <summary>Reset to page 1 when filter changes.</summary>
    async Task ApplyFilter() { page = 1; await Reload(); }

    async Task OnPageChanged(int newPage) { page = newPage; await Reload(); }
    async Task OnPageSizeChanged(int newSize) { pageSize = newSize; page = 1; await Reload(); }

    async Task Clear()
    {
        action = entityType = user = "";
        from = to = null;
        page = 1;
        await Reload();
    }

    async Task DoPurge()
    {
        try
        {
            var n = await Audit.PurgeOlderThanAsync(purgeDays);
            Toast.Success($"Purged {n} audit entries older than {purgeDays} days.");
            await Reload();
            actions = await Audit.GetDistinctActionsAsync();
            entityTypes = await Audit.GetDistinctEntityTypesAsync();
            users = await Audit.GetDistinctUsersAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    static string ActionClass(string action) => $"status-{action.ToLowerInvariant()}";
}

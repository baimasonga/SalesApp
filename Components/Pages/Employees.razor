@page "/employees"
@rendermode InteractiveServer
@inject EmployeeService Emp
@inject InventoryService Inv
@inject LayoutState Layout
@inject ToastService Toast

<PageTitle>Employees</PageTitle>

<div class="page-header">
    <div class="actions">
        <a class="btn" href="/shifts"><i class="bi bi-clock-history"></i> Shifts</a>
        <a class="btn" href="/commissions"><i class="bi bi-cash-coin"></i> Commissions</a>
        <button class="btn btn-primary" @onclick="@(() => Edit(new Employee()))"><i class="bi bi-plus-lg"></i> Add Employee</button>
    </div>
</div>

@if (employees == null) { <Skeleton Height="200" /> }
else if (!employees.Any())
{
    <EmptyState Icon="bi-person-badge" Title="No employees yet" Description="Add your team to track shifts, attribute sales, and pay out commissions.">
        <Actions>
            <button class="btn btn-primary" @onclick="@(() => Edit(new Employee()))"><i class="bi bi-plus-lg"></i> Add employee</button>
        </Actions>
    </EmptyState>
}
else
{
    <table class="table">
        <thead><tr><th>Name</th><th>Role</th><th>Store</th><th>Phone</th><th class="text-right">Salary</th><th class="text-right">Commission</th><th>Active</th><th></th></tr></thead>
        <tbody>
            @foreach (var e in employees)
            {
                <tr>
                    <td><strong>@e.FullName</strong></td>
                    <td><span class="badge">@e.Role</span></td>
                    <td>@e.Store?.Name</td>
                    <td>@e.Phone</td>
                    <td class="text-right">@Money.Format(e.MonthlySalary)</td>
                    <td class="text-right">@(e.CommissionRate * 100)%</td>
                    <td>@(e.IsActive ? "✓" : "—")</td>
                    <td><button class="btn btn-sm" @onclick="() => Edit(e)"><i class="bi bi-pencil"></i></button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editing != null)
{
    <div class="slideover-backdrop" @onclick="() => editing = null"></div>
    <aside class="slideover">
        <div class="slideover-head">
            <div>
                <h3>@(editing.Id == 0 ? "New" : "Edit") employee</h3>
                <p class="muted text-xs mb-0">Profile, role, and compensation.</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="editing" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="slideover-body">
                <div class="form-section">
                    <div class="form-section-title">Profile</div>
                    <div class="form-row">
                        <label>Full name *</label>
                        <InputText @bind-Value="editing.FullName" />
                        <ValidationMessage For="() => editing.FullName" class="field-error" />
                    </div>
                    <div class="form-row"><label>Role</label>
                        <InputSelect @bind-Value="editing.Role">
                            <option>Cashier</option><option>Manager</option><option>Stock Clerk</option>
                            <option>Driver</option><option>Admin</option>
                        </InputSelect>
                    </div>
                    <div class="form-row"><label>Store</label>
                        <InputSelect @bind-Value="editing.StoreId">
                            <option value="0">— None —</option>
                            @if (stores != null) { @foreach (var s in stores) { <option value="@s.Id">@s.Name</option> } }
                        </InputSelect>
                    </div>
                </div>
                <div class="form-section">
                    <div class="form-section-title">Contact</div>
                    <div class="form-row">
                        <label>Phone</label>
                        <InputText @bind-Value="editing.Phone" placeholder="+232 …" />
                        <ValidationMessage For="() => editing.Phone" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Email</label>
                        <InputText @bind-Value="editing.Email" />
                        <ValidationMessage For="() => editing.Email" class="field-error" />
                    </div>
                </div>
                <div class="form-section">
                    <div class="form-section-title">Compensation</div>
                    <div class="form-row"><label>Monthly salary (NLe)</label><InputNumber @bind-Value="editing.MonthlySalary" /></div>
                    <div class="form-row">
                        <label>Commission rate</label>
                        <InputNumber @bind-Value="editing.CommissionRate" />
                        <span class="help">As decimal — 0.02 means 2% of attributed sales.</span>
                    </div>
                </div>
                <div class="form-section">
                    <div class="form-row"><label class="flex items-center gap-2"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label></div>
                </div>
            </div>
            <div class="slideover-foot">
                @if (editing.Id != 0)
                {
                    <button type="button" class="btn btn-danger" style="margin-right: auto;" @onclick="() => confirmDeleteOpen = true">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                }
                <button type="button" class="btn" @onclick="() => editing = null">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save employee</button>
            </div>
        </EditForm>
    </aside>
}

<ConfirmDialog @bind-Open="confirmDeleteOpen"
               Title="Delete this employee?"
               Message="@($"Removing {editing?.FullName}. Employees with shift history are deactivated instead.")"
               ConfirmText="Delete employee"
               Danger="true"
               OnConfirm="DeleteCurrent" />

@code {
    List<Employee>? employees;
    List<Store>? stores;
    Employee? editing;
    bool confirmDeleteOpen;

    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Employees", "Staff & commission rates");
        stores = await Inv.GetStoresAsync();
        employees = await Emp.GetAllAsync();
    }

    void Edit(Employee e) => editing = e;
    async Task Save()
    {
        try { await Emp.SaveAsync(editing!); Toast.Success("Employee saved."); editing = null; employees = await Emp.GetAllAsync(); }
        catch (Exception ex) { Toast.Error($"Save failed: {ex.Message}"); }
    }

    async Task DeleteCurrent()
    {
        if (editing == null || editing.Id == 0) return;
        try { await Emp.DeleteEmployeeAsync(editing.Id); Toast.Success("Employee deleted."); editing = null; employees = await Emp.GetAllAsync(); }
        catch (InvalidOperationException ex) { Toast.Warning(ex.Message); editing = null; employees = await Emp.GetAllAsync(); }
        catch (Exception ex) { Toast.Error($"Delete failed: {ex.Message}"); }
    }
}

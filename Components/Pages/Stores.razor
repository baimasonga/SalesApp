@page "/stores"
@rendermode InteractiveServer
@inject InventoryService Inv
@inject LayoutState Layout
@inject ToastService Toast

<PageTitle>Stores</PageTitle>

<div class="page-header">
    <div class="actions">
        <button class="btn btn-primary" @onclick="@(() => Edit(new Store()))">
            <i class="bi bi-plus-lg"></i> Add Store
        </button>
    </div>
</div>

@if (stores == null) { <Skeleton Height="200" /> }
else if (!stores.Any())
{
    <EmptyState Icon="bi-shop" Title="No stores yet" Description="Add your first store location to start tracking inventory and sales by branch.">
        <Actions>
            <button class="btn btn-primary" @onclick="@(() => Edit(new Store()))"><i class="bi bi-plus-lg"></i> Add store</button>
        </Actions>
    </EmptyState>
}
else
{
    <table class="table">
        <thead><tr><th>Name</th><th>Location</th><th>District</th><th>Phone</th><th>Manager</th><th>Active</th><th></th></tr></thead>
        <tbody>
            @foreach (var s in stores)
            {
                <tr>
                    <td><strong>@s.Name</strong></td>
                    <td>@s.Location</td>
                    <td>@s.District</td>
                    <td>@s.Phone</td>
                    <td>@s.ManagerName</td>
                    <td>@(s.IsActive ? "✓" : "—")</td>
                    <td><button class="btn btn-sm" @onclick="() => Edit(s)" title="Edit"><i class="bi bi-pencil"></i></button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editing != null)
{
    <div class="slideover-backdrop" @onclick="() => editing = null"></div>
    <aside class="slideover">
        <div class="slideover-head">
            <div>
                <h3>@(editing.Id == 0 ? "New" : "Edit") store</h3>
                <p class="muted text-xs mb-0">Branch location and manager details.</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="slideover-body">
            <div class="form-section">
                <div class="form-section-title">Identity</div>
                <div class="form-row"><label>Name *</label><input @bind="editing.Name" placeholder="e.g. Freetown Main" /></div>
                <div class="form-row"><label>Location</label><input @bind="editing.Location" placeholder="Street / area" /></div>
                <div class="form-row"><label>District</label>
                    <select @bind="editing.District">
                        @foreach (var d in Districts) { <option value="@d">@d</option> }
                    </select>
                </div>
            </div>
            <div class="form-section">
                <div class="form-section-title">Contact</div>
                <div class="form-row"><label>Phone</label><input @bind="editing.Phone" placeholder="+232 …" /></div>
                <div class="form-row"><label>Manager</label><input @bind="editing.ManagerName" /></div>
            </div>
            <div class="form-section">
                <div class="form-row"><label class="flex items-center gap-2"><input type="checkbox" @bind="editing.IsActive" /> Active</label></div>
            </div>
        </div>
        <div class="slideover-foot">
            @if (editing.Id != 0)
            {
                <button class="btn btn-danger" style="margin-right: auto;" @onclick="() => confirmDeleteOpen = true">
                    <i class="bi bi-trash"></i> Delete
                </button>
            }
            <button class="btn" @onclick="() => editing = null">Cancel</button>
            <button class="btn btn-primary" @onclick="Save"><i class="bi bi-check-lg"></i> Save store</button>
        </div>
    </aside>
}

<ConfirmDialog @bind-Open="confirmDeleteOpen"
               Title="Delete this store?"
               Message="@($"Removing {editing?.Name}. Stores with sales or stock are deactivated instead of hard-deleted.")"
               ConfirmText="Delete store"
               Danger="true"
               OnConfirm="DeleteCurrent" />

@code {
    List<Store>? stores;
    Store? editing;
    bool confirmDeleteOpen;

    static readonly string[] Districts = new[]
    {
        "Western Area Urban","Western Area Rural","Bo","Bombali","Bonthe","Falaba",
        "Kailahun","Kambia","Karene","Kenema","Koinadugu","Kono","Moyamba","Port Loko",
        "Pujehun","Tonkolili","Makeni"
    };

    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Stores", "Branch locations across Sierra Leone");
        stores = await Inv.GetStoresAsync();
    }

    void Edit(Store s) => editing = s;

    async Task Save()
    {
        if (string.IsNullOrWhiteSpace(editing!.Name)) { Toast.Warning("Name is required."); return; }
        try
        {
            await Inv.SaveStoreAsync(editing);
            Toast.Success("Store saved.");
            editing = null;
            stores = await Inv.GetStoresAsync();
        }
        catch (Exception ex) { Toast.Error($"Save failed: {ex.Message}"); }
    }

    async Task DeleteCurrent()
    {
        if (editing == null || editing.Id == 0) return;
        try { await Inv.DeleteStoreAsync(editing.Id); Toast.Success("Store deleted."); editing = null; stores = await Inv.GetStoresAsync(); }
        catch (InvalidOperationException ex) { Toast.Warning(ex.Message); editing = null; stores = await Inv.GetStoresAsync(); }
        catch (Exception ex) { Toast.Error($"Delete failed: {ex.Message}"); }
    }
}

@page "/sales"
@rendermode InteractiveServer
@inject SalesService SalesSvc
@inject InventoryService Inv
@inject LayoutState Layout
@inject ToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Sales</PageTitle>

<div class="page-header">
    <div class="actions">
        <a class="btn" href="@CsvUrl" target="_blank"><i class="bi bi-download"></i> Export CSV</a>
        <a class="btn btn-primary" href="/sales/new"><i class="bi bi-plus-lg"></i> New Sale</a>
    </div>
</div>

<div class="filter-bar">
    <label>From<input type="date" @bind="from" @bind:after="ApplyFilter" /></label>
    <label>To<input type="date" @bind="to" @bind:after="ApplyFilter" /></label>
    <label>Store
        <select @bind="storeId" @bind:after="ApplyFilter">
            <option value="0">All stores</option>
            @if (stores != null) { @foreach (var s in stores) { <option value="@s.Id">@s.Name</option> } }
        </select>
    </label>
    <button class="btn btn-ghost" @onclick="ClearFilters"><i class="bi bi-x-lg"></i> Clear</button>
</div>

@if (paged == null) { <Skeleton Height="240" /> }
else if (!paged.Items.Any())
{
    <EmptyState Icon="bi-receipt" Title="No sales match these filters" Description="Try clearing filters, or record your first sale.">
        <Actions>
            <a class="btn btn-primary" href="/sales/new"><i class="bi bi-plus-lg"></i> New sale</a>
        </Actions>
    </EmptyState>
}
else
{
    @if (selected.Any())
    {
        <div class="bulk-bar">
            <span><strong>@selected.Count</strong> selected</span>
            <button class="btn btn-sm" @onclick="ExportSelected"><i class="bi bi-download"></i> Export selection</button>
            <button class="btn btn-sm btn-danger" @onclick="() => bulkCancelOpen = true"><i class="bi bi-x-lg"></i> Cancel selection</button>
            <button class="btn btn-sm btn-ghost" @onclick="() => selected.Clear()">Clear</button>
        </div>
    }

    <table class="table">
        <thead>
            <tr>
                <th style="width:36px;">
                    <input type="checkbox" @bind="allSelected" @bind:after="ToggleAll" title="Select all on page" />
                </th>
                <th>Invoice</th><th>Date</th><th>Store</th><th>Customer</th><th>Items</th><th>Payment</th><th>Status</th><th class="text-right">Total</th><th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in paged.Items)
            {
                <tr class="@(selected.Contains(s.Id) ? "is-selected" : "")">
                    <td>
                        <input type="checkbox" checked="@selected.Contains(s.Id)" @onchange="e => ToggleOne(s.Id, (bool)e.Value!)" />
                    </td>
                    <td><strong>@s.InvoiceNumber</strong></td>
                    <td>@s.SaleDate.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@s.Store?.Name</td>
                    <td>@(s.Customer?.FullName ?? "Walk-in")</td>
                    <td>@s.Items.Count</td>
                    <td>@s.PaymentMethod @(string.IsNullOrEmpty(s.TransactionReference) ? "" : "·")@s.TransactionReference</td>
                    <td><span class="status status-@s.Status.ToString().ToLower()">@s.Status</span></td>
                    <td class="text-right">@Money.Format(s.Total, s.Currency)</td>
                    <td>
                        <div class="btn-row">
                            <a class="btn btn-sm" href="/sales/@s.Id/print" title="Print invoice"><i class="bi bi-printer"></i></a>
                            @if (s.Status == SaleStatus.Completed)
                            {
                                <button class="btn btn-sm" @onclick="() => OpenRefund(s)" title="Refund"><i class="bi bi-arrow-counterclockwise"></i></button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Cancel(s.Id)" title="Cancel"><i class="bi bi-x-lg"></i></button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Page="page" PageSize="pageSize" TotalCount="paged.TotalCount"
           PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
}

@if (refundFor != null)
{
    <div class="modal-backdrop" @onclick="() => refundFor = null"></div>
    <div class="modal">
        <h3>Refund @refundFor.InvoiceNumber</h3>
        <p>This will mark the sale as refunded and return items to stock.</p>
        <div class="form-row"><label>Reason</label><textarea rows="3" @bind="refundReason"></textarea></div>
        <div class="modal-actions">
            <button class="btn" @onclick="() => refundFor = null">Cancel</button>
            <button class="btn btn-danger" @onclick="ConfirmRefund">Refund @Money.Format(refundFor.Total, refundFor.Currency)</button>
        </div>
    </div>
}

@code {
    PagedResult<Sale>? paged;
    List<Store>? stores;
    DateTime? from;
    DateTime? to;
    int storeId = 0;
    int page = 1;
    int pageSize = 25;
    Sale? refundFor;
    string refundReason = "";
    HashSet<int> selected = new();
    bool allSelected;
    bool bulkCancelOpen;

    string CsvUrl
    {
        get
        {
            var qs = new List<string>();
            if (from.HasValue) qs.Add($"from={from:yyyy-MM-dd}");
            if (to.HasValue) qs.Add($"to={to:yyyy-MM-dd}");
            if (storeId > 0) qs.Add($"storeId={storeId}");
            return "/export/sales.csv" + (qs.Any() ? "?" + string.Join("&", qs) : "");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Sales", "All transactions across stores");
        stores = await Inv.GetStoresAsync();
        await Reload();
    }

    async Task Reload()
    {
        paged = await SalesSvc.GetPagedAsync(page, pageSize, from, to, storeId == 0 ? null : storeId);
    }

    async Task ApplyFilter() { page = 1; await Reload(); }
    async Task OnPageChanged(int p) { page = p; await Reload(); }
    async Task OnPageSizeChanged(int s) { pageSize = s; page = 1; await Reload(); }

    async Task ClearFilters()
    {
        from = null; to = null; storeId = 0;
        page = 1;
        await Reload();
    }

    async Task Cancel(int id)
    {
        try { await SalesSvc.CancelAsync(id, "Cancelled from sales list"); Toast.Warning("Sale cancelled and stock restored."); await Reload(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    void OpenRefund(Sale s) { refundFor = s; refundReason = ""; }

    async Task ConfirmRefund()
    {
        if (refundFor == null) return;
        try
        {
            await SalesSvc.RefundAsync(refundFor.Id, refundReason);
            Toast.Success($"Refund processed for {refundFor.InvoiceNumber}.");
            refundFor = null;
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ----- Bulk actions -----
    void ToggleAll()
    {
        if (paged == null) return;
        if (allSelected)
            foreach (var s in paged.Items) selected.Add(s.Id);
        else
            foreach (var s in paged.Items) selected.Remove(s.Id);
    }

    void ToggleOne(int id, bool checkedNow)
    {
        if (checkedNow) selected.Add(id); else selected.Remove(id);
        allSelected = paged != null && paged.Items.All(s => selected.Contains(s.Id));
    }

    async Task ExportSelected()
    {
        if (paged == null || !selected.Any()) return;
        var lines = new List<string> { "Invoice,Date,Store,Customer,Payment,Status,Total" };
        foreach (var s in paged.Items.Where(x => selected.Contains(x.Id)))
            lines.Add($"{s.InvoiceNumber},{s.SaleDate:yyyy-MM-dd HH:mm},{s.Store?.Name},{s.Customer?.FullName ?? "Walk-in"},{s.PaymentMethod},{s.Status},{s.Total:F2}");
        var csv = string.Join("\n", lines);
        await JS.InvokeVoidAsync("salone.downloadFile", $"sales_selection_{DateTime.UtcNow:yyyyMMdd_HHmm}.csv", "text/csv", csv);
        Toast.Success($"Exported {selected.Count} sale(s).");
    }

    async Task DoBulkCancel()
    {
        var ids = selected.ToList();
        int cancelled = 0;
        foreach (var id in ids)
        {
            try { await SalesSvc.CancelAsync(id, "Bulk cancel"); cancelled++; } catch { }
        }
        Toast.Warning($"Cancelled {cancelled} of {ids.Count} sale(s).");
        selected.Clear();
        allSelected = false;
        await Reload();
    }
}

<ConfirmDialog @bind-Open="bulkCancelOpen"
               Title="Cancel selected sales?"
               Message="@($"This will cancel {selected.Count} sale(s) and restore stock. Already-cancelled or refunded sales are skipped.")"
               ConfirmText="Cancel sales"
               Danger="true"
               OnConfirm="DoBulkCancel" />

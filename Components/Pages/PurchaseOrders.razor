@page "/purchase-orders"
@rendermode InteractiveServer
@inject PurchaseOrderService Po
@inject LayoutState Layout
@inject ToastService Toast

<PageTitle>Purchase Orders</PageTitle>

<div class="page-header">
    <div class="actions">
        <a class="btn btn-primary" href="/purchase-orders/new"><i class="bi bi-plus-lg"></i> New PO</a>
    </div>
</div>

@if (paged == null) { <Skeleton Height="200" /> }
else if (!paged.Items.Any())
{
    <EmptyState Icon="bi-cart3" Title="No purchase orders" Description="Create POs to send to your suppliers; receiving them auto-credits stock to the chosen store.">
        <Actions>
            <a class="btn btn-primary" href="/purchase-orders/new"><i class="bi bi-plus-lg"></i> New PO</a>
        </Actions>
    </EmptyState>
}
else
{
    <table class="table">
        <thead><tr><th>PO Number</th><th>Date</th><th>Supplier</th><th>Store</th><th>Items</th><th class="text-right">Total</th><th>Status</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in paged.Items)
            {
                <tr>
                    <td><strong>@p.PoNumber</strong></td>
                    <td>@p.OrderDate.ToString("dd MMM yyyy")</td>
                    <td>@p.Supplier?.Name</td>
                    <td>@p.Store?.Name</td>
                    <td>@p.Items.Count</td>
                    <td class="text-right">@Money.Format(p.Total)</td>
                    <td><span class="status status-@p.Status.ToString().ToLower()">@p.Status</span></td>
                    <td>
                        <div class="row-actions">
                            @if (p.Status == PurchaseOrderStatus.Draft || p.Status == PurchaseOrderStatus.Submitted)
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => Receive(p.Id)" title="Receive into stock"><i class="bi bi-box-arrow-in-down"></i> Receive</button>
                                <button class="btn btn-sm" @onclick="() => Cancel(p.Id)" title="Cancel"><i class="bi bi-x"></i></button>
                            }
                            @if (p.Status != PurchaseOrderStatus.Received)
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => AskDelete(p)" title="Delete"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Page="page" PageSize="pageSize" TotalCount="paged.TotalCount"
           PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
}

@code {
    PagedResult<PurchaseOrder>? paged;
    int page = 1;
    int pageSize = 25;
    bool confirmDeleteOpen;
    PurchaseOrder? deletingPo;
    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Purchase Orders", "Stock orders sent to suppliers");
        paged = await Po.GetPosPagedAsync(page, pageSize);
    }

    async Task OnPageChanged(int p) { page = p; paged = await Po.GetPosPagedAsync(page, pageSize); }
    async Task OnPageSizeChanged(int s) { pageSize = s; page = 1; paged = await Po.GetPosPagedAsync(page, pageSize);
    }
    async Task Receive(int id)
    {
        try { await Po.ReceiveAsync(id); Toast.Success("Stock received."); paged = await Po.GetPosPagedAsync(page, pageSize); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    async Task Cancel(int id)
    {
        try { await Po.CancelAsync(id); Toast.Warning("PO cancelled."); paged = await Po.GetPosPagedAsync(page, pageSize); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    void AskDelete(PurchaseOrder p) { deletingPo = p; confirmDeleteOpen = true; }

    async Task DoDelete()
    {
        if (deletingPo == null) return;
        try { await Po.DeleteAsync(deletingPo.Id); Toast.Success("PO deleted."); paged = await Po.GetPosPagedAsync(page, pageSize); }
        catch (InvalidOperationException ex) { Toast.Warning(ex.Message); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { deletingPo = null; }
    }
}

<ConfirmDialog @bind-Open="confirmDeleteOpen"
               Title="Delete this PO?"
               Message="@($"Removing {deletingPo?.PoNumber}. Received POs are protected (stock has been credited).")"
               ConfirmText="Delete PO"
               Danger="true"
               OnConfirm="DoDelete" />

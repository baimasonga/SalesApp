@page "/products"
@rendermode InteractiveServer
@inject InventoryService Inv
@inject LayoutState Layout
@inject ToastService Toast

<PageTitle>Products</PageTitle>

<div class="page-header">
    <div class="actions">
        <button class="btn btn-primary" @onclick="@(() => Edit(new Product()))">
            <i class="bi bi-plus-lg"></i> Add Product
        </button>
    </div>
</div>

@if (paged == null) { <Skeleton Height="240" /> }
else if (!paged.Items.Any())
{
    <EmptyState Icon="bi-tag" Title="Your catalogue is empty" Description="Add your first product to start selling. Each product carries SKU, barcode, cost price, and selling price.">
        <Actions>
            <button class="btn btn-primary" @onclick="@(() => Edit(new Product()))"><i class="bi bi-plus-lg"></i> Add product</button>
        </Actions>
    </EmptyState>
}
else
{
    <table class="table">
        <thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Unit</th><th class="text-right">Cost</th><th class="text-right">Price</th><th class="text-right">Margin</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in paged.Items)
            {
                var margin = p.UnitPrice == 0 ? 0 : Math.Round((p.UnitPrice - p.CostPrice) / p.UnitPrice * 100m, 1);
                var color = margin >= 25 ? "var(--success)" : margin >= 10 ? "var(--warning)" : "var(--danger)";
                <tr>
                    <td><code>@p.Sku</code></td>
                    <td>
                        <div class="flex items-center gap-2">
                            <div class="kpi-icon" style="width: 30px; height: 30px; font-size: .85rem; @ProductIconStyle(p.Category)">
                                <i class="bi @ProductIcon(p.Category)"></i>
                            </div>
                            <strong>@p.Name</strong>
                        </div>
                    </td>
                    <td><span class="badge">@p.Category</span></td>
                    <td>@p.Unit</td>
                    <td class="text-right">@Money.Format(p.CostPrice)</td>
                    <td class="text-right"><strong>@Money.Format(p.UnitPrice)</strong></td>
                    <td class="text-right" style="color: @color"><strong>@margin%</strong></td>
                    <td>
                        <div class="row-actions">
                            <button class="btn btn-sm" @onclick="() => Edit(p)" title="Edit"><i class="bi bi-pencil"></i></button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <Pager Page="page" PageSize="pageSize" TotalCount="paged.TotalCount"
           PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
}

@if (editing != null)
{
    <div class="slideover-backdrop" @onclick="() => editing = null"></div>
    <aside class="slideover">
        <div class="slideover-head">
            <div>
                <h3>@(editing.Id == 0 ? "New" : "Edit") product</h3>
                <p class="muted text-xs mb-0">SKU · pricing · category</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
        </div>
        <EditForm Model="editing" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="slideover-body">
                <div class="form-section">
                    <div class="form-section-title">Identity</div>
                    <div class="form-row">
                        <label>SKU *</label>
                        <InputText @bind-Value="editing.Sku" placeholder="e.g. RIC-50" />
                        <ValidationMessage For="() => editing.Sku" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Barcode</label>
                        <InputText @bind-Value="editing.Barcode" placeholder="EAN-13 / UPC" />
                        <span class="help">Scan the product or type the digits.</span>
                    </div>
                    <div class="form-row">
                        <label>Name *</label>
                        <InputText @bind-Value="editing.Name" />
                        <ValidationMessage For="() => editing.Name" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Category</label>
                        <InputSelect @bind-Value="editing.Category">
                            @foreach (var c in Categories) { <option>@c</option> }
                        </InputSelect>
                    </div>
                    <div class="form-row"><label>Unit</label><InputText @bind-Value="editing.Unit" placeholder="pcs / bag / case…" /></div>
                </div>
                <div class="form-section">
                    <div class="form-section-title">Pricing</div>
                    <div class="form-row">
                        <label>Cost price (NLe)</label>
                        <InputNumber @bind-Value="editing.CostPrice" />
                        <ValidationMessage For="() => editing.CostPrice" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Selling price (NLe) *</label>
                        <InputNumber @bind-Value="editing.UnitPrice" />
                        <ValidationMessage For="() => editing.UnitPrice" class="field-error" />
                        @if (editing.UnitPrice > 0 && editing.CostPrice > 0)
                        {
                            var pct = Math.Round((editing.UnitPrice - editing.CostPrice) / editing.UnitPrice * 100m, 1);
                            <span class="help">Margin: <strong>@pct%</strong></span>
                        }
                    </div>
                </div>
                <div class="form-section">
                    <div class="form-row"><label class="flex items-center gap-2"><InputCheckbox @bind-Value="editing.IsActive" /> Active</label></div>
                </div>
            </div>
            <div class="slideover-foot">
                @if (editing.Id != 0)
                {
                    <button type="button" class="btn btn-danger" style="margin-right: auto;" @onclick="() => confirmDeleteOpen = true">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                }
                <button type="button" class="btn" @onclick="() => editing = null">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save product</button>
            </div>
        </EditForm>
    </aside>
}

<ConfirmDialog @bind-Open="confirmDeleteOpen"
               Title="Delete this product?"
               Message="@($"Removing {editing?.Name}. Products with sales history are deactivated (soft-delete) instead of hard-deleted.")"
               ConfirmText="Delete product"
               Danger="true"
               OnConfirm="DeleteCurrent" />

@code {
    static readonly string[] Categories = { "Foodstuff", "Building", "Electronics", "Telecom", "Household", "Beverage", "Textile", "Other" };

    PagedResult<Product>? paged;
    int page = 1;
    int pageSize = 25;
    Product? editing;
    bool confirmDeleteOpen;

    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Products", "Catalogue & pricing");
        paged = await Inv.GetProductsPagedAsync(page, pageSize);
    }
    async Task OnPageChanged(int p) { page = p; paged = await Inv.GetProductsPagedAsync(page, pageSize); }
    async Task OnPageSizeChanged(int s) { pageSize = s; page = 1; paged = await Inv.GetProductsPagedAsync(page, pageSize); }
    void Edit(Product p) => editing = p;

    async Task Save()
    {
        try
        {
            await Inv.SaveProductAsync(editing!);
            Toast.Success("Product saved.");
            editing = null;
            paged = await Inv.GetProductsPagedAsync(page, pageSize);
        }
        catch (Exception ex) { Toast.Error($"Save failed: {ex.Message}"); }
    }

    async Task DeleteCurrent()
    {
        if (editing == null || editing.Id == 0) return;
        try { await Inv.DeleteProductAsync(editing.Id); Toast.Success("Product deleted."); editing = null; paged = await Inv.GetProductsPagedAsync(page, pageSize); }
        catch (InvalidOperationException ex) { Toast.Warning(ex.Message); editing = null; paged = await Inv.GetProductsPagedAsync(page, pageSize); }
        catch (Exception ex) { Toast.Error($"Delete failed: {ex.Message}"); }
    }

    static string ProductIcon(string? cat) => cat switch
    {
        "Foodstuff" => "bi-basket",
        "Building" => "bi-bricks",
        "Electronics" => "bi-cpu",
        "Telecom" => "bi-phone-vibrate",
        "Household" => "bi-house-heart",
        "Beverage" => "bi-cup-straw",
        "Textile" => "bi-bag",
        _ => "bi-tag"
    };
    static string ProductIconStyle(string? cat) => cat switch
    {
        "Foodstuff" => "background: var(--success-bg); color: var(--success);",
        "Building" => "background: #fff7ed; color: #f97316;",
        "Electronics" => "background: var(--info-bg); color: var(--info);",
        "Telecom" => "background: var(--violet-bg); color: var(--violet);",
        "Household" => "background: #fdf2f8; color: #ec4899;",
        "Beverage" => "background: #ecfeff; color: #06b6d4;",
        "Textile" => "background: var(--warning-bg); color: var(--warning);",
        _ => "background: var(--surface-3); color: var(--text-muted);"
    };
}

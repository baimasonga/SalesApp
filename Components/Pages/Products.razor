@page "/products"
@rendermode InteractiveServer
@inject InventoryService Inv

<PageTitle>Products</PageTitle>

<div class="page-header">
    <h1>Products</h1>
    <button class="btn btn-primary" @onclick="@(() => Edit(new Product()))">+ Add Product</button>
</div>

@if (products == null) { <p>Loading…</p> }
else
{
    <table class="table">
        <thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Unit</th><th class="text-right">Cost</th><th class="text-right">Price</th><th></th></tr></thead>
        <tbody>
            @foreach (var p in products)
            {
                <tr>
                    <td><code>@p.Sku</code></td>
                    <td>@p.Name</td>
                    <td>@p.Category</td>
                    <td>@p.Unit</td>
                    <td class="text-right">@Money.Format(p.CostPrice)</td>
                    <td class="text-right"><strong>@Money.Format(p.UnitPrice)</strong></td>
                    <td><button class="btn btn-sm" @onclick="() => Edit(p)">Edit</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@if (editing != null)
{
    <div class="modal-backdrop" @onclick="() => editing = null"></div>
    <div class="modal">
        <h3>@(editing.Id == 0 ? "New" : "Edit") Product</h3>
        <div class="form-row"><label>SKU</label><input @bind="editing.Sku" /></div>
        <div class="form-row"><label>Name</label><input @bind="editing.Name" /></div>
        <div class="form-row"><label>Category</label><input @bind="editing.Category" /></div>
        <div class="form-row"><label>Unit</label><input @bind="editing.Unit" /></div>
        <div class="form-row"><label>Cost Price</label><input type="number" step="0.01" @bind="editing.CostPrice" /></div>
        <div class="form-row"><label>Unit Price</label><input type="number" step="0.01" @bind="editing.UnitPrice" /></div>
        <div class="form-row"><label>Active</label><input type="checkbox" @bind="editing.IsActive" /></div>
        <div class="modal-actions">
            <button class="btn" @onclick="() => editing = null">Cancel</button>
            <button class="btn btn-primary" @onclick="Save">Save</button>
        </div>
    </div>
}

@code {
    List<Product>? products;
    Product? editing;

    protected override async Task OnInitializedAsync() => products = await Inv.GetProductsAsync();
    void Edit(Product p) => editing = p;
    async Task Save()
    {
        await Inv.SaveProductAsync(editing!);
        editing = null;
        products = await Inv.GetProductsAsync();
    }
}

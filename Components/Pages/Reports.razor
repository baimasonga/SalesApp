@page "/reports"
@rendermode InteractiveServer
@inject AnalyticsService Analytics

<PageTitle>Reports & Analytics</PageTitle>

<h1>Reports & Analytics</h1>
<p class="muted">Performance insights for your business.</p>

@if (loading) { <p>Loading…</p> }
else
{
    <div class="grid-2">
        <div class="card">
            <h3>Daily Revenue (last 30 days)</h3>
            <BarChart Points="daily" Color="#2563eb" />
        </div>
        <div class="card">
            <h3>Top Products by Revenue</h3>
            <BarChart Points="topProducts" Color="#16a34a" Horizontal="true" />
        </div>
        <div class="card">
            <h3>Sales by Store</h3>
            <BarChart Points="byStore" Color="#9333ea" Horizontal="true" />
        </div>
        <div class="card">
            <h3>Payment Methods</h3>
            <BarChart Points="paymentMix" Color="#ea580c" Horizontal="true" />
        </div>
    </div>
}

@code {
    bool loading = true;
    List<SeriesPoint> daily = new();
    List<SeriesPoint> topProducts = new();
    List<SeriesPoint> byStore = new();
    List<SeriesPoint> paymentMix = new();

    protected override async Task OnInitializedAsync()
    {
        daily = await Analytics.GetDailyRevenueAsync(30);
        topProducts = await Analytics.GetTopProductsAsync(10);
        byStore = await Analytics.GetSalesByStoreAsync();
        paymentMix = await Analytics.GetPaymentMixAsync();
        loading = false;
    }
}

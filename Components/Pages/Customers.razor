@page "/customers"
@rendermode InteractiveServer
@inject CrmService Crm
@inject LayoutState Layout
@inject ToastService Toast

<PageTitle>Customers</PageTitle>

<div class="page-header">
    <div class="actions">
        <button class="btn btn-primary" @onclick="@(() => Edit(new Customer()))">
            <i class="bi bi-plus-lg"></i> Add Customer
        </button>
    </div>
</div>

<div class="card card-tight mb-3">
    <div class="input-group">
        <i class="bi bi-search"></i>
        <input class="search" placeholder="Search by name, business, phone, or email…"
               @bind="search" @bind:event="oninput" @bind:after="ApplyFilter" />
    </div>
</div>

@if (paged == null)
{
    <div class="grid-2">
        @for (int i = 0; i < 6; i++)
        {
            <div class="card"><Skeleton Height="56" /></div>
        }
    </div>
}
else if (!paged.Items.Any())
{
    <EmptyState Icon="bi-people" Title="No customers match" Description="Try clearing the search, or add your first customer.">
        <Actions>
            <button class="btn btn-primary" @onclick="@(() => Edit(new Customer()))"><i class="bi bi-plus-lg"></i> Add Customer</button>
        </Actions>
    </EmptyState>
}
else
{
    <div class="customer-grid">
        @foreach (var c in paged.Items)
        {
            <div class="customer-tile" @onclick="() => GoTo(c.Id)">
                <Avatar Name="@c.FullName" Size="md" Color="@AvatarColor(c.Id)" />
                <div class="customer-tile-body">
                    <strong>@c.FullName</strong>
                    @if (!string.IsNullOrEmpty(c.BusinessName))
                    {
                        <span class="muted text-xs">@c.BusinessName</span>
                    }
                    <div class="customer-tile-meta">
                        <span class="badge">@c.Segment</span>
                        @if (!string.IsNullOrEmpty(c.Phone))
                        {
                            <span class="text-xs muted"><i class="bi bi-telephone"></i> @c.Phone</span>
                        }
                    </div>
                </div>
                <button class="btn btn-ghost btn-sm" @onclick:stopPropagation="true" @onclick="() => Edit(c)" title="Edit">
                    <i class="bi bi-pencil"></i>
                </button>
            </div>
        }
    </div>

    <Pager Page="page" PageSize="pageSize" TotalCount="paged.TotalCount"
           PageChanged="OnPageChanged" PageSizeChanged="OnPageSizeChanged" />
}

@if (editing != null)
{
    <div class="slideover-backdrop" @onclick="() => editing = null"></div>
    <aside class="slideover">
        <div class="slideover-head">
            <div>
                <h3>@(editing.Id == 0 ? "New" : "Edit") customer</h3>
                <p class="muted text-xs mb-0">Manage profile, contact, and segment.</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="() => editing = null"><i class="bi bi-x-lg"></i></button>
        </div>

        <EditForm Model="editing" OnValidSubmit="Save">
            <DataAnnotationsValidator />
            <div class="slideover-body">
                <div class="form-section">
                    <div class="form-section-title">Identity</div>
                    <div class="form-row">
                        <label>Full name *</label>
                        <InputText @bind-Value="editing.FullName" />
                        <ValidationMessage For="() => editing.FullName" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Business name</label>
                        <InputText @bind-Value="editing.BusinessName" />
                        <ValidationMessage For="() => editing.BusinessName" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Segment</label>
                        <InputSelect @bind-Value="editing.Segment">
                            @foreach (var v in Enum.GetValues<CustomerSegment>()) { <option value="@v">@v</option> }
                        </InputSelect>
                    </div>
                </div>
                <div class="form-section">
                    <div class="form-section-title">Contact</div>
                    <div class="form-row">
                        <label>Phone</label>
                        <InputText @bind-Value="editing.Phone" placeholder="+232 …" />
                        <ValidationMessage For="() => editing.Phone" class="field-error" />
                    </div>
                    <div class="form-row">
                        <label>Email</label>
                        <InputText @bind-Value="editing.Email" placeholder="someone@example.com" />
                        <ValidationMessage For="() => editing.Email" class="field-error" />
                    </div>
                    <div class="form-row"><label>District</label><InputText @bind-Value="editing.District" /></div>
                    <div class="form-row"><label>Address</label><InputText @bind-Value="editing.Address" /></div>
                </div>
                <div class="form-section">
                    <div class="form-section-title">Notes</div>
                    <div class="form-row"><InputTextArea rows="4" @bind-Value="editing.Notes" placeholder="Any context worth remembering…" /></div>
                </div>
            </div>

            <div class="slideover-foot">
                @if (editing.Id != 0)
                {
                    <button type="button" class="btn btn-danger" style="margin-right: auto;" @onclick="() => confirmDeleteOpen = true">
                        <i class="bi bi-trash"></i> Delete
                    </button>
                }
                <button type="button" class="btn" @onclick="() => editing = null">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Save customer</button>
            </div>
        </EditForm>
    </aside>
}

<ConfirmDialog @bind-Open="confirmDeleteOpen"
               Title="Delete this customer?"
               Message="@($"This will permanently remove {editing?.FullName}. Their sales will be re-attributed to walk-in. Interactions are also deleted.")"
               ConfirmText="Delete customer"
               Danger="true"
               OnConfirm="DeleteCurrent" />

<style>
    .customer-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: .75rem;
    }
    .customer-tile {
        display: flex; align-items: center; gap: .85rem;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        padding: .85rem 1rem;
        cursor: pointer;
        transition: all var(--transition);
    }
    .customer-tile:hover {
        border-color: var(--brand);
        box-shadow: var(--shadow-md);
        transform: translateY(-1px);
    }
    .customer-tile-body { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: .15rem; }
    .customer-tile-body strong { font-weight: 500; color: var(--text); font-size: .9rem; }
    .customer-tile-body .muted { font-size: .72rem; }
    .customer-tile-meta { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; margin-top: .25rem; }
</style>

@code {
    [Inject] NavigationManager Nav { get; set; } = default!;

    PagedResult<Customer>? paged;
    Customer? editing;
    string? search;
    int page = 1;
    int pageSize = 24;
    bool confirmDeleteOpen;

    static readonly string[] Palette = {
        "linear-gradient(135deg, #4f46e5, #8b5cf6)",
        "linear-gradient(135deg, #10b981, #059669)",
        "linear-gradient(135deg, #f97316, #ea580c)",
        "linear-gradient(135deg, #ec4899, #db2777)",
        "linear-gradient(135deg, #0ea5e9, #0284c7)",
        "linear-gradient(135deg, #f59e0b, #d97706)",
    };

    protected override async Task OnInitializedAsync()
    {
        Layout.Set("Customers", "Directory & relationship management");
        await Reload();
    }

    async Task Reload() => paged = await Crm.GetCustomersPagedAsync(page, pageSize, search);
    async Task ApplyFilter() { page = 1; await Reload(); }
    async Task OnPageChanged(int p) { page = p; await Reload(); }
    async Task OnPageSizeChanged(int s) { pageSize = s; page = 1; await Reload(); }
    void Edit(Customer c) => editing = c;
    void GoTo(int id) => Nav.NavigateTo($"/customers/{id}");
    string AvatarColor(int id) => Palette[Math.Abs(id) % Palette.Length];

    async Task Save()
    {
        try
        {
            await Crm.SaveAsync(editing!);
            Toast.Success("Customer saved.");
            editing = null;
            await Reload();
        }
        catch (Exception ex) { Toast.Error($"Save failed: {ex.Message}"); }
    }

    async Task DeleteCurrent()
    {
        if (editing == null || editing.Id == 0) return;
        try
        {
            await Crm.DeleteAsync(editing.Id);
            Toast.Success("Customer deleted.");
            editing = null;
            await Reload();
        }
        catch (Exception ex) { Toast.Error($"Delete failed: {ex.Message}"); }
    }
}

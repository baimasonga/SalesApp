@page "/customers/{Id:int}"
@rendermode InteractiveServer
@inject CrmService Crm
@inject LayoutState Layout
@inject NavigationManager Nav

@if (customer == null)
{
    <p>Loading…</p>
}
else
{
    <PageTitle>@customer.FullName</PageTitle>

    <div class="page-header">
        <div class="actions">
            <a class="btn" href="/customers"><i class="bi bi-arrow-left"></i> Back to customers</a>
        </div>
    </div>
    <p class="muted mb-3">
        @customer.BusinessName
        @if (!string.IsNullOrEmpty(customer.BusinessName) && !string.IsNullOrEmpty(customer.District)) { <span> · </span> }
        @customer.District
        · <span class="badge">@customer.Segment</span>
    </p>

    <div class="grid-2">
        <div class="card">
            <h3>Contact</h3>
            <p><strong>Phone:</strong> @customer.Phone
                @if (!string.IsNullOrEmpty(customer.Phone))
                {
                    <a class="btn btn-sm" href="@($"tel:{customer.Phone}")"><i class="bi bi-telephone"></i> Call</a>
                    <a class="btn btn-sm" href="@($"sms:{customer.Phone}")"><i class="bi bi-chat-left-dots"></i> SMS</a>
                    <a class="btn btn-sm" href="@WhatsAppLink(customer.Phone)" target="_blank"><i class="bi bi-whatsapp"></i> WhatsApp</a>
                }
            </p>
            <p><strong>Email:</strong> @customer.Email
                @if (!string.IsNullOrEmpty(customer.Email))
                {
                    <a class="btn btn-sm" href="@($"mailto:{customer.Email}")"><i class="bi bi-envelope"></i> Email</a>
                }
            </p>
            <p><strong>Address:</strong> @customer.Address</p>
            <p><strong>Notes:</strong> @customer.Notes</p>
            <p><strong><i class="bi bi-gift"></i> Loyalty Points:</strong> <span class="badge">@customer.LoyaltyPoints</span> (1 pt per NLe 100 spent)</p>
            <p class="muted">Customer since @customer.CreatedAt.ToString("dd MMM yyyy")</p>
        </div>

        <div class="card">
            <h3>Log Interaction</h3>
            <div class="form-row"><label>Type</label>
                <select @bind="newInt.Type">
                    @foreach (var v in Enum.GetValues<InteractionType>()) { <option value="@v">@v</option> }
                </select>
            </div>
            <div class="form-row"><label>Subject</label><input @bind="newInt.Subject" /></div>
            <div class="form-row"><label>Details</label><textarea rows="3" @bind="newInt.Details"></textarea></div>
            <div class="form-row"><label>Owner</label><input @bind="newInt.Owner" /></div>
            <div class="form-row"><label>Follow-up</label>
                <input type="date" @bind="followUp" />
            </div>
            <button class="btn btn-primary" @onclick="LogInteraction">Save Interaction</button>
        </div>
    </div>

    <div class="card">
        <h3>Interaction History</h3>
        @if (customer.Interactions.Any())
        {
            <table class="table">
                <thead><tr><th>When</th><th>Type</th><th>Subject</th><th>Details</th><th>Owner</th><th>Follow-up</th><th></th></tr></thead>
                <tbody>
                    @foreach (var i in customer.Interactions.OrderByDescending(i => i.When))
                    {
                        <tr>
                            <td>@i.When.ToString("dd MMM yyyy HH:mm")</td>
                            <td><span class="badge">@i.Type</span></td>
                            <td>@i.Subject</td>
                            <td>@i.Details</td>
                            <td>@i.Owner</td>
                            <td>@i.FollowUpDate?.ToString("dd MMM")</td>
                            <td>
                                <div class="row-actions">
                                    <button class="btn btn-sm" @onclick="() => EditInteraction(i)" title="Edit"><i class="bi bi-pencil"></i></button>
                                    <button class="btn btn-sm btn-danger" @onclick="() => AskDeleteInteraction(i)" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else { <p class="muted">No interactions yet.</p> }
    </div>

    <div class="card">
        <h3>Sales History</h3>
        @if (customer.Sales.Any())
        {
            <table class="table">
                <thead><tr><th>Invoice</th><th>Date</th><th>Status</th><th class="text-right">Total</th></tr></thead>
                <tbody>
                    @foreach (var s in customer.Sales.OrderByDescending(s => s.SaleDate))
                    {
                        <tr>
                            <td>@s.InvoiceNumber</td>
                            <td>@s.SaleDate.ToString("dd MMM yyyy")</td>
                            <td>@s.Status</td>
                            <td class="text-right">@Money.Format(s.Total)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <p><strong>Lifetime Value:</strong> @Money.Format(customer.Sales.Where(s => s.Status == SaleStatus.Completed).Sum(s => s.Total))</p>
        }
        else { <p class="muted">No purchases yet.</p> }
    </div>
}

@if (editingInt != null)
{
    <div class="slideover-backdrop" @onclick="() => editingInt = null"></div>
    <aside class="slideover">
        <div class="slideover-head">
            <div>
                <h3>Edit interaction</h3>
                <p class="muted text-xs mb-0">@editingInt.When.ToString("dd MMM yyyy HH:mm")</p>
            </div>
            <button class="btn btn-ghost btn-icon" @onclick="() => editingInt = null"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="slideover-body">
            <div class="form-row"><label>Type</label>
                <select @bind="editingInt.Type">
                    @foreach (var v in Enum.GetValues<InteractionType>()) { <option value="@v">@v</option> }
                </select>
            </div>
            <div class="form-row"><label>Subject</label><input @bind="editingInt.Subject" /></div>
            <div class="form-row"><label>Details</label><textarea rows="4" @bind="editingInt.Details"></textarea></div>
            <div class="form-row"><label>Owner</label><input @bind="editingInt.Owner" /></div>
            <div class="form-row"><label>Follow-up date</label><input type="date" @bind="editingInt.FollowUpDate" /></div>
        </div>
        <div class="slideover-foot">
            <button class="btn" @onclick="() => editingInt = null">Cancel</button>
            <button class="btn btn-primary" @onclick="SaveInteraction"><i class="bi bi-check-lg"></i> Save</button>
        </div>
    </aside>
}

<ConfirmDialog @bind-Open="confirmDeleteIntOpen"
               Title="Delete this interaction?"
               Message="@($"Removing \"{deletingInt?.Subject}\" from {deletingInt?.When:dd MMM yyyy}.")"
               ConfirmText="Delete"
               Danger="true"
               OnConfirm="DoDeleteInteraction" />

@code {
    [Parameter] public int Id { get; set; }
    Customer? customer;
    Interaction newInt = new();
    DateTime? followUp;
    Interaction? editingInt;
    Interaction? deletingInt;
    bool confirmDeleteIntOpen;

    protected override async Task OnParametersSetAsync()
    {
        customer = await Crm.GetAsync(Id);
        Layout.Set(customer?.FullName ?? "Customer", customer?.BusinessName);
        newInt = new Interaction { CustomerId = Id, When = DateTime.UtcNow };
    }

    static string WhatsAppLink(string? phone)
    {
        if (string.IsNullOrWhiteSpace(phone)) return "#";
        var digits = new string(phone.Where(char.IsDigit).ToArray());
        return $"https://wa.me/{digits}";
    }

    void EditInteraction(Interaction i) => editingInt = i;

    async Task SaveInteraction()
    {
        if (editingInt == null) return;
        await Crm.UpdateInteractionAsync(editingInt);
        editingInt = null;
        customer = await Crm.GetAsync(Id);
    }

    void AskDeleteInteraction(Interaction i) { deletingInt = i; confirmDeleteIntOpen = true; }

    async Task DoDeleteInteraction()
    {
        if (deletingInt == null) return;
        await Crm.DeleteInteractionAsync(deletingInt.Id);
        deletingInt = null;
        customer = await Crm.GetAsync(Id);
    }

    async Task LogInteraction()
    {
        if (string.IsNullOrWhiteSpace(newInt.Subject)) return;
        newInt.CustomerId = Id;
        newInt.When = DateTime.UtcNow;
        newInt.FollowUpDate = followUp;
        await Crm.LogInteractionAsync(newInt);
        customer = await Crm.GetAsync(Id);
        newInt = new Interaction { CustomerId = Id };
        followUp = null;
    }
}

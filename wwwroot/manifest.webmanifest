{
  "name": "Salone Sales",
  "short_name": "Salone Sales",
  "description": "Sales, inventory & CRM for Sierra Leone businesses",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#0b1220",
  "theme_color": "#0072c6",
  "orientation": "portrait-primary",
  "categories": ["business", "finance", "productivity"],

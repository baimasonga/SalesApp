    { "src": "/icons/icon-maskable.svg",  "sizes": "any",         "type": "image/svg+xml", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New Sale",  "url": "/sales/new",  "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Dashboard", "url": "/",           "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] },
    { "name": "Customers", "url": "/customers",  "icons": [{ "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml" }] }
  ]
}
